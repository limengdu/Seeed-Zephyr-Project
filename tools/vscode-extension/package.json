{
  "name": "seeed-xiao-zephyr-assistant",
  "displayName": "Seeed XIAO Zephyr Assistant",
  "description": "Discover and create XIAO + Grove Zephyr examples, then hand build/flash to Zephyr tooling.",
  "version": "0.4.0",
  "publisher": "seeed-studio",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/limengdu/Seeed-Zephyr-Project"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:metadata/boards",
    "workspaceContains:snapshot.json",
    "workspaceContains:prj.conf"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seeedZephyr",
          "title": "Seeed XIAO Zephyr",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "seeedZephyr": [
        {
          "id": "seeedZephyrWelcome",
          "name": "Welcome",
          "visibility": "visible"
        },
        {
          "id": "seeedZephyrProjects",
          "name": "Projects",
          "visibility": "visible"
        },
        {
          "id": "seeedZephyrEnvironment",
          "name": "Environment",
          "visibility": "visible"
        },
        {
          "id": "seeedZephyrCatalog",
          "name": "Catalog",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "seeedZephyr.refreshCatalog",
        "title": "Refresh Catalog",
        "category": "Seeed XIAO",
        "icon": "$(refresh)"
      },
      {
        "command": "seeedZephyr.updateRepository",
        "title": "Update Repository",
        "category": "Seeed XIAO",
        "icon": "$(sync)"
      },
      {
        "command": "seeedZephyr.setupEnvironment",
        "title": "Run Full Setup",
        "category": "Seeed XIAO",
        "icon": "$(rocket)"
      },
      {
        "command": "seeedZephyr.useExistingCli",
        "title": "Use System CLI",
        "category": "Seeed XIAO",
        "icon": "$(terminal)"
      },
      {
        "command": "seeedZephyr.installManagedCli",
        "title": "Install Latest CLI",
        "category": "Seeed XIAO",
        "icon": "$(cloud-download)"
      },
      {
        "command": "seeedZephyr.reinstallManagedCli",
        "title": "Reinstall CLI",
        "category": "Seeed XIAO",
        "icon": "$(debug-restart)"
      },
      {
        "command": "seeedZephyr.selectCliVersion",
        "title": "Choose CLI Version",
        "category": "Seeed XIAO",
        "icon": "$(versions)"
      },
      {
        "command": "seeedZephyr.verifyCli",
        "title": "Verify CLI",
        "category": "Seeed XIAO",
        "icon": "$(verified)"
      },
      {
        "command": "seeedZephyr.selectCliPath",
        "title": "Select CLI Path",
        "category": "Seeed XIAO",
        "icon": "$(folder-opened)"
      },
      {
        "command": "seeedZephyr.recheckEnvironment",
        "title": "Refresh Environment Status",
        "category": "Seeed XIAO",
        "icon": "$(refresh)"
      },
      {
        "command": "seeedZephyr.setRepoRoot",
        "title": "Select Repository Folder",
        "category": "Seeed XIAO",
        "icon": "$(repo)"
      },
      {
        "command": "seeedZephyr.showDetail",
        "title": "Show Detail",
        "category": "Seeed XIAO"
      },
      {
        "command": "seeedZephyr.createProject",
        "title": "Create Project",
        "category": "Seeed XIAO",
        "icon": "$(new-folder)"
      },
      {
        "command": "seeedZephyr.openGenerated",
        "title": "Open Project",
        "category": "Seeed XIAO",
        "icon": "$(folder-opened)"
      },
      {
        "command": "seeedZephyr.build",
        "title": "Build",
        "category": "Seeed XIAO",
        "icon": "$(tools)"
      },
      {
        "command": "seeedZephyr.flash",
        "title": "Flash",
        "category": "Seeed XIAO",
        "icon": "$(zap)"
      },
      {
        "command": "seeedZephyr.monitor",
        "title": "Monitor",
        "category": "Seeed XIAO",
        "icon": "$(pulse)"
      },
      {
        "command": "seeedZephyr.debug",
        "title": "Debug",
        "category": "Seeed XIAO",
        "icon": "$(debug-alt)"
      },
      {
        "command": "seeedZephyr.projectBuild",
        "title": "Build Project",
        "category": "Seeed XIAO"
      },
      {
        "command": "seeedZephyr.selectProjectBoard",
        "title": "Select Project Board",
        "category": "Seeed XIAO",
        "icon": "$(circuit-board)"
      },
      {
        "command": "seeedZephyr.selectProjectPort",
        "title": "Select Project Port",
        "category": "Seeed XIAO",
        "icon": "$(plug)"
      },
      {
        "command": "seeedZephyr.projectFlash",
        "title": "Upload Project",
        "category": "Seeed XIAO"
      },
      {
        "command": "seeedZephyr.projectFlashMonitor",
        "title": "Upload and Monitor Project",
        "category": "Seeed XIAO",
        "icon": "$(rocket)"
      },
      {
        "command": "seeedZephyr.projectMonitor",
        "title": "Monitor Project",
        "category": "Seeed XIAO"
      },
      {
        "command": "seeedZephyr.configurePins",
        "title": "Configure Pins",
        "category": "Seeed XIAO",
        "icon": "$(symbol-parameter)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "seeedZephyr.showDetail", "when": "false" },
        { "command": "seeedZephyr.build", "when": "false" },
        { "command": "seeedZephyr.flash", "when": "false" },
        { "command": "seeedZephyr.monitor", "when": "false" },
        { "command": "seeedZephyr.debug", "when": "false" },
        { "command": "seeedZephyr.createProject" },
        { "command": "seeedZephyr.openGenerated" },
        { "command": "seeedZephyr.selectProjectBoard" },
        { "command": "seeedZephyr.selectProjectPort" },
        { "command": "seeedZephyr.configurePins" },
        { "command": "seeedZephyr.projectFlashMonitor" },
        { "command": "seeedZephyr.setupEnvironment" },
        { "command": "seeedZephyr.useExistingCli" },
        { "command": "seeedZephyr.installManagedCli" },
        { "command": "seeedZephyr.reinstallManagedCli" },
        { "command": "seeedZephyr.selectCliVersion" },
        { "command": "seeedZephyr.verifyCli" },
        { "command": "seeedZephyr.selectCliPath" },
        { "command": "seeedZephyr.recheckEnvironment" }
      ],
      "view/title": [
        {
          "command": "seeedZephyr.updateRepository",
          "when": "view == seeedZephyrCatalog",
          "group": "navigation@3"
        },
        {
          "command": "seeedZephyr.refreshCatalog",
          "when": "view == seeedZephyrCatalog",
          "group": "navigation@4"
        },
        {
          "command": "seeedZephyr.createProject",
          "when": "view == seeedZephyrProjects",
          "group": "navigation@1"
        },
        {
          "command": "seeedZephyr.openGenerated",
          "when": "view == seeedZephyrProjects",
          "group": "navigation@2"
        },
        {
          "command": "seeedZephyr.recheckEnvironment",
          "when": "view == seeedZephyrEnvironment",
          "group": "navigation@1"
        },
        {
          "command": "seeedZephyr.verifyCli",
          "when": "view == seeedZephyrEnvironment",
          "group": "navigation@2"
        },
        {
          "command": "seeedZephyr.reinstallManagedCli",
          "when": "view == seeedZephyrEnvironment",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "seeedZephyr.createProject",
          "when": "view == seeedZephyrCatalog && viewItem == example",
          "group": "inline"
        },
        {
          "command": "seeedZephyr.createProject",
          "when": "view == seeedZephyrCatalog && viewItem == groveExample",
          "group": "inline"
        },
        {
          "command": "seeedZephyr.createProject",
          "when": "view == seeedZephyrCatalog && viewItem == example",
          "group": "1_actions"
        },
        {
          "command": "seeedZephyr.createProject",
          "when": "view == seeedZephyrCatalog && viewItem == groveExample",
          "group": "1_actions"
        },
        {
          "command": "seeedZephyr.createProject",
          "when": "view == seeedZephyrCatalog && viewItem == board",
          "group": "1_actions"
        },
        {
          "command": "seeedZephyr.build",
          "when": "view == seeedZephyrCatalog && viewItem == example",
          "group": "2_run"
        },
        {
          "command": "seeedZephyr.flash",
          "when": "view == seeedZephyrCatalog && viewItem == example",
          "group": "2_run"
        },
        {
          "command": "seeedZephyr.monitor",
          "when": "view == seeedZephyrCatalog && viewItem == example",
          "group": "2_run"
        },
        {
          "command": "seeedZephyr.debug",
          "when": "view == seeedZephyrCatalog && viewItem == example",
          "group": "2_run"
        },
        {
          "command": "seeedZephyr.build",
          "when": "view == seeedZephyrCatalog && viewItem == board",
          "group": "2_run"
        },
        {
          "command": "seeedZephyr.flash",
          "when": "view == seeedZephyrCatalog && viewItem == board",
          "group": "2_run"
        },
        {
          "command": "seeedZephyr.monitor",
          "when": "view == seeedZephyrCatalog && viewItem == board",
          "group": "2_run"
        }
      ]
    },
    "configuration": {
      "title": "Seeed XIAO Zephyr Assistant",
      "properties": {
        "seeedZephyr.repoRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the seeed-zephyr-base repository. Auto-detected from the workspace when empty."
        },
        "seeedZephyr.cliPath": {
          "type": "string",
          "default": "",
          "description": "Override the seeed-zephyr CLI command used for create and execute actions."
        },
        "seeedZephyr.managedCliVersion": {
          "type": "string",
          "default": "",
          "description": "Version of the extension-managed seeed-zephyr CLI."
        },
        "seeedZephyr.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter used for managed CLI installation and CLI helper commands."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "test": "node test/runTests.js",
    "package": "vsce package"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
